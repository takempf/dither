{
	"name": "dither",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"emulators": "firebase emulators:start --only firestore,storage",
		"deploy": "npm run build && firebase deploy",
		"preview": "vite preview",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/eslint": "^9.6.0",
		"@types/firebase": "^3.2.1",
		"@types/upng-js": "^2.1.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"firebase-tools": "^15.33.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.0",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vite-plugin-wasm": "^3.3.0"
	},
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"packageManager": "npm@11.19.0",
	"dependencies": {
		"@fontsource/im-fell-english": "^5.3.0",
		"@fontsource/noto-emoji": "^5.3.2",
		"@internationalized/date": "^3.12.4",
		"bits-ui": "^2.19.5",
		"canvas-dither": "^1.0.1",
		"firebase": "^13.0.0",
		"human-id": "^4.1.1",
		"just-throttle": "^4.2.0",
		"modern-gif": "^2.0.3",
		"store2": "^2.14.3",
		"upng-js": "^2.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
