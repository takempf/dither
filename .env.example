# Copy to .env for prod builds. Dev uses the emulators and needs neither.
PUBLIC_FIREBASE_API_KEY=
# reCAPTCHA Enterprise site key registered for App Check. Leave empty to turn App Check off.
PUBLIC_RECAPTCHA_SITE_KEY=
# true makes a prod build use the local emulators (used by e2e tests)
PUBLIC_USE_FIREBASE_EMULATORS=
